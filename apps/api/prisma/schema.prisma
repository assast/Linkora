generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  singleton       Boolean  @unique @default(true)
  email           String   @unique @db.VarChar(254)
  passwordHash    String   @map("password_hash")
  contentRevision Int      @default(0) @map("content_revision")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  sessions        Session[]
  categories      Category[]
  bookmarks       Bookmark[]
  tags            Tag[]
  preferences     UserPreferences?

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  csrfToken String   @map("csrf_token") @db.Char(64)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  name      String   @db.VarChar(40)
  isPrivate Boolean  @default(false) @map("is_private")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  parent    Category? @relation("CategoryTree", fields: [ownerId, parentId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)
  children  Category[] @relation("CategoryTree")
  bookmarks Bookmark[]

  @@unique([ownerId, id])
  @@index([ownerId, parentId])
  @@map("categories")
}

model Bookmark {
  id            String   @id @default(uuid()) @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  categoryId    String?  @map("category_id") @db.Uuid
  title         String   @db.VarChar(200)
  url           String   @db.VarChar(4096)
  url2          String?  @db.VarChar(4096)
  description   String   @default("") @db.VarChar(1000)
  notes         String   @default("")
  isPrivate     Boolean  @default(false) @map("is_private")
  isFavorite    Boolean  @default(false) @map("is_favorite")
  visitCount    Int      @default(0) @map("visit_count")
  lastVisitedAt DateTime? @map("last_visited_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category      Category? @relation(fields: [ownerId, categoryId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)
  tags          BookmarkTag[]
  icon          BookmarkIcon?

  @@unique([ownerId, id])
  @@index([ownerId, categoryId, createdAt])
  @@index([ownerId, isFavorite])
  @@map("bookmarks")
}

enum IconSource {
  AUTO
  DASHBOARD
  UPLOAD
}

model BookmarkIcon {
  bookmarkId      String     @id @map("bookmark_id") @db.Uuid
  source          IconSource
  version         String     @db.Uuid
  dashboardId     String?    @map("dashboard_id") @db.VarChar(120)
  dashboardCommit String?    @map("dashboard_commit") @db.Char(40)
  dashboardFormat String?    @map("dashboard_format") @db.VarChar(4)
  uploadKey       String?    @map("upload_key") @db.Uuid
  bookmark        Bookmark   @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@map("bookmark_icons")
}

model Tag {
  id             String @id @default(uuid()) @db.Uuid
  ownerId        String @map("owner_id") @db.Uuid
  name           String @db.VarChar(40)
  normalizedName String @map("normalized_name") @db.VarChar(40)
  owner          User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bookmarks      BookmarkTag[]

  @@unique([ownerId, id])
  @@unique([ownerId, normalizedName])
  @@map("tags")
}

model BookmarkTag {
  ownerId    String   @map("owner_id") @db.Uuid
  bookmarkId String   @map("bookmark_id") @db.Uuid
  tagId      String   @map("tag_id") @db.Uuid
  bookmark   Bookmark @relation(fields: [ownerId, bookmarkId], references: [ownerId, id], onDelete: Cascade, onUpdate: NoAction)
  tag        Tag      @relation(fields: [ownerId, tagId], references: [ownerId, id], onDelete: Restrict, onUpdate: NoAction)

  @@id([bookmarkId, tagId])
  @@index([tagId])
  @@map("bookmark_tags")
}

model UserPreferences {
  userId             String @id @map("user_id") @db.Uuid
  theme              String @default("light")
  defaultEngine      String @default("google") @map("default_engine")
  defaultView        String @default("list") @map("default_view")
  expandedCategories String[] @default([]) @map("expanded_categories") @db.Uuid
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
